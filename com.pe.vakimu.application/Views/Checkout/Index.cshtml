@model com.pe.vakimu.application.Models.Response.CheckoutView
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Checkout";
 
}
<div class="checkout-container">
    <div class="checkout-content">
        <!-- Formulario de checkout -->
        <div class="checkout-form">
            <form id="checkout-form">
                @Html.AntiForgeryToken()
                <!-- Sección Contacto -->
                <div class="form-section">
                    <h3>Contacto</h3>
                    <div class="login-link">
                        <a href="#" onclick="iniciarSesion()">Iniciar sesión</a>
                    </div>

                    <div class="form-group">
                        <input type="email" id="correo" name="correo" placeholder="Correo electrónico" required>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="newsletter" name="newsletter">
                        <label for="newsletter">Envíame novedades y ofertas por correo electrónico</label>
                    </div>
                </div>

                <!-- Sección Entrega -->
                <div class="form-section">
                    <h3>Entrega</h3>

                    <div class="delivery-options">
                        <div class="delivery-option active" data-type="delivery">
                            <i class="bi bi-truck"></i>
                            <span>Envío</span>
                            <i class="bi bi-box-arrow-right ms-auto"></i>
                        </div>
                        <div class="delivery-option" data-type="retiro">
                            <i class="bi bi-shop"></i>
                            <span>Retiro en tienda</span>
                            <i class="bi bi-building ms-auto"></i>
                        </div>
                    </div>

                    <!-- Sección de sucursales (oculta por defecto) -->

                    <div id="sucursales-section" class="sucursales-section" style="display: none;">
                        <div class="sucursales-header">
                            <h4>Sucursales de tienda</h4>
                        </div>
                        <p class="sucursales-info">Hay @Model.Sucursales.Count tiendas con existencias cerca de tu ubicación.</p>
                        <div class="sucursales-list">
                            @foreach (var s in Model.Sucursales)
                            {
                                var idInput = $"sucursal{s.Id}";
                                <div class="sucursal-option" data-sucursal="@s.Id">
                                    <input type="radio" id="@idInput" name="sucursalSeleccionada" value="@s.Id">
                                    <label for="@idInput" class="sucursal-label">
                                        <div class="sucursal-info">
                                            <div class="sucursal-name">
                                                @s.Sede
                                            </div>
                                            <div class="sucursal-address">
                                                @s.Calle, @s.Ubicacion
                                            </div>
                                        </div>
                                        <div class="sucursal-delivery">
                                            <div class="envio-gratis">ENVÍO GRATIS</div>
                                            <div class="tiempo-entrega">Normalmente está listo en 24 horas</div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                    </div>

                    @*Info*@
                    <div class="pt-3">
                        <div>
                            <div class="form-group">
                                <input type="text" id="nombre" name="nombre" placeholder="Nombre" required>
                            </div>
                            <div class="form-group">
                                <input type="text" id="apellidos" name="apellidos" placeholder="Apellidos" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <input type="text" id="ruc" name="ruc" placeholder="RUC si necesita factura" maxlength="11">
                        </div>

                        <div class="form-group">
                            <input type="text" id="direccion" name="direccion" placeholder="Dirección" required>
                        </div>

                        <div class="form-group">
                            <input type="text" id="descripcionCasa" name="descripcionCasa" placeholder="Casa, apartamento, etc. (opcional)">
                        </div>

                        <div class="form-row three-cols">
                            <div class="form-group">
                                <input type="text" id="dni" name="dni" placeholder="DNI o CE" maxlength="8" required>
                            </div>

                            <div class="form-group">
                                <input type="text" id="distrito" name="distrito" placeholder="Distrito" required>
                            </div>

                     
                        </div>

                        <div class="form-group">
                            <input type="tel" id="telefono" name="telefono" placeholder="Teléfono" maxlength="9" required>
                        </div>
                        <div class="form-group">
                            <label for="departamento">Departamento</label>
                            <select id="departamento" name="departamentoId" required class="form-control">
                                <option value="">-- Selecciona un departamento --</option>
                                @foreach (var departamento in Model.Departamentos)
                                {
                                    <option value="@departamento.Id">@departamento.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    
                    <div class="form-check">
                        <input type="checkbox" id="guardarInfo" name="guardarInfo">
                        <label for="guardarInfo">Guardar mi información y consultar más rápidamente la próxima vez</label>
                    </div>
                </div>
                <!-- Métodos de pago -->
                <div class="form-section">
                    <h3>Pago</h3>
                    <p class="payment-subtitle">Todas las transacciones son seguras y están encriptadas.</p>

                    <div class="payment-methods">
                        @for (int i = 0; i < Model.MetodosPago.Count; i++)
                        {
                            var metodo = Model.MetodosPago[i];
                            var esActivo = metodo.Id == 1; // Por ejemplo, activa BBVA por defecto
                            var idRadio = "metodo" + metodo.Id;
                            <div class="payment-method @(esActivo ? "active" : "")" data-method="@metodo.Id">
                                <input type="radio" id="@idRadio" name="metodoPagoId" value="@metodo.Id" @(esActivo ? "checked" : "")>
                                <label for="@idRadio" class="payment-label">
                                    @if (metodo.Nombre.Contains("BBVA"))
                                    {
                                        <i class="bi bi-check-circle payment-check"></i>
                                    }
                                    <span>@metodo.Nombre</span>
                                    @if (metodo.Nombre.Contains("BBVA"))
                                    {
                                        <div class="payment-icons">
                                            <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/Visa.svg" alt="Visa" class="payment-icon"/>
                                            <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/Mastercard-logo.png" alt="Mastercard" class="payment-icon"/>
                                        </div>
                                    }
                                </label>

                                <div class="payment-details" style="@(esActivo ? "" : "display: none;")">
                                    <p>@Html.Raw(System.Text.RegularExpressions.Regex.Unescape(metodo.Instrucciones).Replace("\n", "<br>"))
                                    </p>
                                </div>
                            </div>
                        }
                    </div>

                </div>

            </form>
        </div>

        <!-- Resumen del pedido -->
        <div class="order-summary">
            <div class="summary-content">
                <div id="order-items">
                    <!-- Los productos se cargarán aquí -->
                </div>

                <div class="discount-section">
                    <div class="discount-input">
                        <input type="text" id="codigoDescuento" placeholder="Código de descuento">
                        <button type="button" onclick="aplicarDescuento()">Aplicar</button>
                    </div>
                </div>

                <div class="summary-totals">
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span id="subtotal">S/ 0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Costo de envío <i class="bi bi-info-circle"></i></span>
                        <span id="costoEnvio">S/ 10.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <div class="total-amount">
                            <small>PEN</small>
                            <strong id="total">S/ 0.00</strong>
                        </div>
                    </div>
                    <div class="tax-info">
                        <small>Incluye S/ <span id="igv">0.00</span> de IGV</small>
                    </div>
                </div>

                <button type="button" class="complete-order-btn" onclick="completarPedido()">
                    Completar pedido
                </button>
            </div>
            <div id="error-pedido" class="alert alert-danger" style="display: none;"></div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/Scripts/checkout.js"></script>
}