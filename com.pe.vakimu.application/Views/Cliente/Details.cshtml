@model com.pe.vakimu.application.Models.Entities.Cliente

@{
    ViewBag.Title = "Detalle de Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> Detalle del Cliente</h4>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Departamento</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Departamento.Nombre)</dd>

                <dt class="col-sm-4 text-muted">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Nombre)</dd>

                <dt class="col-sm-4 text-muted">Apellidos</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Apellidos)</dd>

                <dt class="col-sm-4 text-muted">Correo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Correo)</dd>

                <dt class="col-sm-4 text-muted">Contraseña</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Contrasena)</dd>

                <dt class="col-sm-4 text-muted">Teléfono</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Telefono)</dd>

                <dt class="col-sm-4 text-muted">DNI</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Dni)</dd>

                <dt class="col-sm-4 text-muted">Distrito</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Distrito)</dd>

                <dt class="col-sm-4 text-muted">Dirección</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Direccion)</dd>

                <dt class="col-sm-4 text-muted">Descripción de Casa</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.DescripcionCasa)</dd>
            </dl>
        </div>

        <div class="card-footer text-end bg-light">
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
