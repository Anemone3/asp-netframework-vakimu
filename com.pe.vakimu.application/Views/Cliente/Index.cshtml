@model IEnumerable<com.pe.vakimu.application.Models.Entities.Cliente>

@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">📋 Lista de Clientes</h2>
        @Html.ActionLink("➕ Nuevo Cliente", "Create", null, new { @class = "btn btn-success" })
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().Departamento.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Apellidos)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Correo)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Contrasena)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Direccion)</th>
                    <th>@Html.DisplayNameFor(model => model.First().DescripcionCasa)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Telefono)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Dni)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Distrito)</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Departamento.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellidos)</td>
                        <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Contrasena)</td>
                        <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                        <td>@Html.DisplayFor(modelItem => item.DescripcionCasa)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                        <td>@Html.DisplayFor(modelItem => item.Distrito)</td>
                        <td class="text-center">
                            @Html.ActionLink("✏️", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary", title = "Editar" })
                            @Html.ActionLink("🔍", "Details", new { id = item.Id }, new { @class = "btn btn-outline-secondary", title = "Detalles" })
                            @Html.ActionLink("🗑️", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger", title = "Eliminar" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
