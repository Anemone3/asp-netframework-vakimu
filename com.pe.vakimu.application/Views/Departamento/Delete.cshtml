@model com.pe.vakimu.application.Models.Entities.Departamento

@{
    ViewBag.Title = "Eliminar Departamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">⚠️ Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <p class="fs-5">¿Estás seguro de que deseas eliminar este departamento?</p>
                    <dl class="row">
                        <dt class="col-sm-4 fw-semibold">
                            @Html.DisplayNameFor(model => model.Nombre)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Nombre)
                        </dd>
                    </dl>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-end">
                            <input type="submit" value="Eliminar" class="btn btn-danger me-2" />
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
