@model IEnumerable<com.pe.vakimu.application.Models.Entities.Departamento>

@{
    ViewBag.Title = "Departamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-primary mb-0">📋 Lista de Departamentos</h1>
        @Html.ActionLink("➕ Nuevo Departamento", "Create", null, new { @class = "btn btn-success shadow-sm" })
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th class="text-center" style="width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                                    <td class="text-center">
                                        @Html.ActionLink("✏️", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary", title = "Editar" })
                                        @Html.ActionLink("🔍", "Details", new { id = item.Id }, new { @class = "btn btn-outline-secondary", title = "Detalles" })
                                        @Html.ActionLink("🗑️", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger", title = "Eliminar" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3"></i><br />
                                    No hay departamentos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
