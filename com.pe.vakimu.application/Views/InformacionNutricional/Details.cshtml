@model com.pe.vakimu.application.Models.Entities.InformacionNutricional

@{
    ViewBag.Title = "Detalles de Información Nutricional";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-info-circle-fill"></i> Detalles de Información Nutricional
            </h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Producto</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Producto.Nombre)</dd>

                <dt class="col-sm-4">Energía (Kcal)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.EnergiaKcal)</dd>

                <dt class="col-sm-4">Grasa Total</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.GrasaTotal)</dd>

                <dt class="col-sm-4">Grasa Saturada</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.GrasaSaturada)</dd>

                <dt class="col-sm-4">Grasa Trans</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.GrasaTrans)</dd>

                <dt class="col-sm-4">Colesterol (mg)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.ColesterolMg)</dd>

                <dt class="col-sm-4">Sodio (mg)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.SodioMg)</dd>

                <dt class="col-sm-4">Carbohidratos Totales</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CarbohidratosTotales)</dd>

                <dt class="col-sm-4">Fibra Dietaria</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FibraDietaria)</dd>

                <dt class="col-sm-4">Azúcares Totales</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.AzucaresTotales)</dd>

                <dt class="col-sm-4">Azúcares Añadidos</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.AzucaresAnhadidos)</dd>

                <dt class="col-sm-4">Proteína</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Proteina)</dd>
            </dl>
        </div>
        <div class="card-footer text-end bg-light">
            @Html.ActionLink("Editar", "Edit", new { id = Model.IdProducto }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
