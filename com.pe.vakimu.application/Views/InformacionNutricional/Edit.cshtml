@model com.pe.vakimu.application.Models.Entities.InformacionNutricional

@{
    ViewBag.Title = "Editar Información Nutricional";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i> Editar Información Nutricional
            </h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.IdProducto)

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.EnergiaKcal)
                        @Html.EditorFor(m => m.EnergiaKcal, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.EnergiaKcal, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.GrasaTotal)
                        @Html.EditorFor(m => m.GrasaTotal, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.GrasaTotal, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.GrasaSaturada)
                        @Html.EditorFor(m => m.GrasaSaturada, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.GrasaSaturada, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.GrasaTrans)
                        @Html.EditorFor(m => m.GrasaTrans, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.GrasaTrans, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ColesterolMg)
                        @Html.EditorFor(m => m.ColesterolMg, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.ColesterolMg, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.SodioMg)
                        @Html.EditorFor(m => m.SodioMg, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.SodioMg, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CarbohidratosTotales)
                        @Html.EditorFor(m => m.CarbohidratosTotales, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.CarbohidratosTotales, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FibraDietaria)
                        @Html.EditorFor(m => m.FibraDietaria, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.FibraDietaria, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.AzucaresTotales)
                        @Html.EditorFor(m => m.AzucaresTotales, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.AzucaresTotales, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.AzucaresAnhadidos)
                        @Html.EditorFor(m => m.AzucaresAnhadidos, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.AzucaresAnhadidos, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Proteina)
                        @Html.EditorFor(m => m.Proteina, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Proteina, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <input type="submit" value="Guardar Cambios" class="btn btn-success me-2" />
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}
