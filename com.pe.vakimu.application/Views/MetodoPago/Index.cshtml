@model IEnumerable<com.pe.vakimu.application.Models.Entities.MetodoPago>

@{
    ViewBag.Title = "Index";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2 class="fw-bold">Métodos de Pago</h2>
    @Html.ActionLink("Nuevo Método", "Create", null, new { @class = "btn btn-success" })
</div>

<table class="table table-striped table-bordered align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.First().Instrucciones)</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Instrucciones)</td>
                <td class="text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        @Html.ActionLink("✏️", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary", title = "Editar" })
                        @Html.ActionLink("🔍", "Details", new { id = item.Id }, new { @class = "btn btn-outline-secondary", title = "Detalles" })
                        @Html.ActionLink("🗑️", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger", title = "Eliminar" })
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
