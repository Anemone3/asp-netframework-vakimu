@model com.pe.vakimu.application.Models.Entities.Orden

@{
    ViewBag.Title = "Nueva Orden";
}

<div class="container mt-4">
    <h2 class="mb-4">Crear Nueva Orden</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.ClienteId, "Cliente", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("ClienteId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.ClienteId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.SucursalId, "Sucursal", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("SucursalId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.SucursalId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Tipo, htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("Tipo",
                        new SelectList(new[] { "Delivery", "Retiro" }, ViewData["Tipo"] ?? ""),
                        "Seleccione una opción",
                        new { @class = "form-select", id = "TipoSelect" })
                    @Html.ValidationMessageFor(model => model.Tipo, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Estado, htmlAttributes: new { @class = "form-label" })
                    @Html.TextBox("estadoVisible", "Pendiente", new { @class = "form-control", @readonly = "readonly" })
                    @Html.HiddenFor(model => model.Estado, new { @Value = "Pendiente" })
                    @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Ruc, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.Ruc, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Ruc, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.MetodoPagoId, "Método de Pago", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("MetodoPagoId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.MetodoPagoId, "", new { @class = "text-danger" })
                </div>

                <!-- Dirección solo si es Delivery -->
                <div id="direccionCampos" style="display:none;">
                    <hr />
                    <h5 class="mb-3">Dirección de Entrega</h5>

                    <div class="mb-3">
                        <label class="form-label">Dirección Línea 1</label>
                        <input type="text" name="DireccionLinea1" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección Línea 2</label>
                        <input type="text" name="DireccionLinea2" class="form-control" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ciudad</label>
                            <input type="text" name="Ciudad" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Distrito</label>
                            <input type="text" name="Distrito" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Código Postal</label>
                        <input type="text" name="CodigoPostal" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Referencia</label>
                        <textarea name="Referencia" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-end">
                    <input type="submit" value="Guardar Orden" class="btn btn-success" />
                    @Html.ActionLink("Cancelar", "Index", "Home", null, new { @class = "btn btn-secondary ms-2" })
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            function camposDelivery() {
                const tipo = $('#TipoSelect').val();
                if (tipo === "Delivery") {
                    $('#direccionCampos').slideDown();
                } else {
                    $('#direccionCampos').slideUp();
                }
            }

            camposDelivery();

            $('#TipoSelect').on('change', function () {
                camposDelivery();
            });
        });
    </script>
}
