@model com.pe.vakimu.application.Models.Entities.Producto

@{
    ViewBag.Title = "Detalles del Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-box-seam"></i> Detalles del Producto</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <strong>@Html.DisplayFor(model => model.Nombre)</strong>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <img src="@Model.Imagen" alt="Imagen del producto" class="img-fluid rounded border" onerror="this.src='/Images/placeholder.png'" />
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-4">ID Nutricional</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.InformacionNutricional.IdProducto)</dd>

                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                        <dt class="col-sm-4">SKU</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Sku)</dd>

                        <dt class="col-sm-4">Precio</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

                        <dt class="col-sm-4">Precio Oferta</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioOferta)</dd>

                        <dt class="col-sm-4">Stock</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Stock)</dd>

                        <dt class="col-sm-4">Disponible</dt>
                        <dd class="col-sm-8">
                            @if (Model.Disponible)
                            {
                                <span class="badge bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Última Actualización</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaActualizada)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
}
