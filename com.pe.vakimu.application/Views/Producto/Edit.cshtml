@model com.pe.vakimu.application.Models.Entities.Producto

@{
    ViewBag.Title = "Editar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-pencil-square"></i> Editar Producto</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="card shadow-sm">
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.Sku, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Sku, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Sku, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.Precio, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Precio, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.PrecioOferta, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.PrecioOferta, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PrecioOferta, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.Stock, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Stock, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Stock, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.FechaActualizada, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.FechaActualizada, new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.FechaActualizada, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.Disponible, new { @class = "form-label d-block" })
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(model => model.Disponible, new { @class = "form-check-input" })
                            <label class="form-check-label">¿Disponible?</label>
                        </div>
                        @Html.ValidationMessageFor(model => model.Disponible, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    @Html.LabelFor(model => model.Imagen, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.Imagen, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Imagen, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="card-footer bg-light text-end">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
}
