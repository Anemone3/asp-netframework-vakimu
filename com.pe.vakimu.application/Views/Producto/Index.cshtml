@model IEnumerable<com.pe.vakimu.application.Models.Entities.Producto>

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Lista de Productos</h2>
        <a href="@Url.Action("Create")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </a>
    </div>

    <table class="table table-hover table-bordered align-middle shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>ID Nutrición</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>SKU</th>
                <th>Precio</th>
                <th>Oferta</th>
                <th>Stock</th>
                <th>Disponible</th>
                <th>Imagen</th>
                <th>Actualizado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InformacionNutricional.IdProducto</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Sku</td>
                    <td>S/. @item.Precio.ToString("N2")</td>
                    <td>
                        @if (item.PrecioOferta.HasValue)
                        {
                            <span class="text-danger fw-semibold">S/. @item.PrecioOferta.Value.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>@item.Stock</td>
                    <td>
                        @if (item.Disponible)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Imagen))
                        {
                            <img src="@Url.Content(item.Imagen)" alt="Imagen" width="60" height="60" class="img-thumbnail" />
                        }
                        else
                        {
                            <span class="text-muted">Sin imagen</span>
                        }
                    </td>
                    <td>@item.FechaActualizada</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            @Html.ActionLink("✏️", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary", title = "Editar" })
                            @Html.ActionLink("🔍", "Details", new { id = item.Id }, new { @class = "btn btn-outline-secondary", title = "Detalles" })
                            @Html.ActionLink("🗑️", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger", title = "Eliminar" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
