@model com.pe.vakimu.application.Models.Entities.Sucursal

@{
    ViewBag.Title = "Detalle de Sucursal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-info-circle-fill"></i> Detalles de la Sucursal</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Departamento.Nombre)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Departamento.Nombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Ubicacion)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Ubicacion)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Longitud)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Longitud)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Latitud)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Latitud)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Sede)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Sede)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Calle)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Calle)</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver a la lista
            </a>
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
        </div>
    </div>
</div>
